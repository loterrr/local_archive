# LocalRAG Configuration Template
# Copy this file to .env on your new machine:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)

# -------------------------------------------------------------
# LLM Inference (Ollama)
# -------------------------------------------------------------
# Base URL for Ollama local service
LOCALRAG_LLM_BASE_URL=http://127.0.0.1:11434

# LLM Model tag installed in Ollama (e.g. phi3.5:latest, qwen2.5:3b, mistral)
LOCALRAG_LLM_MODEL=phi3.5:latest

# -------------------------------------------------------------
# Embeddings & Retrieval
# -------------------------------------------------------------
# Dense embedding model for FAISS vector search
LOCALRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Initial top-K passages retrieved by dense vector search
LOCALRAG_DENSE_K=32

# Reciprocal Rank Fusion (RRF) smoothing parameter (standard default: 60)
LOCALRAG_RRF_K=60

# -------------------------------------------------------------
# Cross-Encoder Neural Reranking
# -------------------------------------------------------------
# Set to 'true' to enable Stage 2 Cross-Encoder reranking
LOCALRAG_RERANKER_ENABLED=true

# Fast 2-layer CPU reranker (~290ms latency)
LOCALRAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-2-v2

# Number of candidates passed from Stage 1 to Stage 2 reranker
LOCALRAG_RERANKER_CANDIDATES=50

# Batch size for reranker inference
LOCALRAG_RERANKER_BATCH_SIZE=32

# Final top-K passages delivered to the LLM prompt context
LOCALRAG_FINAL_K=8

# -------------------------------------------------------------
# Caching Configuration
# -------------------------------------------------------------
LOCALRAG_CACHE_SIZE=128
LOCALRAG_CACHE_TTL=300
